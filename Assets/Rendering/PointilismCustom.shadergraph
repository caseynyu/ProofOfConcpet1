            "m_Id": "3580e458c81844f6a0d770b79a9fe58d"
        },
        {
            "m_Id": "0e4678b4da8d4c019cdfc5f92b005552"
        },
        {
            "m_Id": "3fa4d599f244418a98fabc61a005badb"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VoronoiSolidColor",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 g = floor(UV * CellDensity);\r\nfloat2 f = frac(UV * CellDensity);\r\nfloat res = 8.0;\r\nfloat2 closestCellCenter = float2(0,0);\r\n\r\nfor(int y=-1; y<=1; y++) {\r\n    for(int x=-1; x<=1; x++) {\r\n        float2 lattice = float2(x, y);\r\n        float2 latticeUV = g + lattice;\r\n        \r\n        float2x2 m = float2x2(15.27, 47.63, 99.41, 89.98);\r\n        float2 n = frac(sin(mul(latticeUV, m)) * 46839.32);\r\n        float2 offset = float2(sin(n.y + AngleOffset)*0.5+0.5, cos(n.x * AngleOffset)*0.5+0.5);\r\n\r\n        float2 v = lattice + offset - f;\r\n        float d = dot(v, v);\r\n\r\n        if(d < res) {\r\n            res = d;\r\n            closestCellCenter = (latticeUV + offset) / CellDensity;\r\n        }\r\n    }\r\n}\r\nOut = sqrt(res);\r\nCellUV = closestCellCenter;"
}

